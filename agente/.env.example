# Copiar como .env SOLO para pruebas locales (está en .gitignore). En el hosting, cargar como variables de entorno.
# Nunca pegar valores reales en este archivo ni en el repositorio.
WHATSAPP_VERIFY_TOKEN=            # texto largo y aleatorio que inventas tú; se escribe igual en el panel de Meta
META_APP_SECRET=                  # Meta > App "Ortopedia HS Mensajes" > Configuración > Básica > Clave secreta
WHATSAPP_TOKEN=                   # token PERMANENTE de un usuario del sistema (el temporal vence en 24 h)
WHATSAPP_PHONE_NUMBER_ID=1379790768560621   # número de prueba; cambiar al del número real
ANTHROPIC_API_KEY=                # clave de la API de Claude (console.anthropic.com)
CLAUDE_MODEL=claude-haiku-5-5     # modelo económico; se puede subir si hace falta
NUMERO_EQUIPO=                    # opcional: 569XXXXXXXX de quien atiende (recibe el aviso de derivación)
MAX_MENSAJES_POR_HORA=30
SIMULACION=0                      # 1 = no llama a WhatsApp ni a Claude (solo pruebas)
